[faire "collection.tools"]
	url = {{ collection_url }}
	path = code/containers
	revision = {{ collection_revision }}
# Primary rule: one sample of the stream to this dataset. Adapt the sample entities in the
# patterns ({subject}, {session}, ...) to those of the plan.
[datalad "containers.convert"]
	image = code/containers/images/TODO
	cmdexec = {img} {cmd}
	faire-sourcedata = {{ source }}
	faire-input = sourcedata/{{ source }}/*/sub-{subject}/ses-{session}/*
	faire-output = sub-{subject}/ses-{session}
	faire-cmd = TODO {inputs} {outputs}
# Secondary rule: reads what `convert` wrote (`.` is the dataset itself) and runs after it.
[datalad "containers.process"]
	image = code/containers/images/TODO
	cmdexec = {img} {cmd}
	faire-sourcedata = .
	faire-input = sub-{subject}/ses-{session}/*
	faire-output = sub-{subject}/ses-{session}/*
	faire-after = convert
	faire-cmd = TODO {outputs}
[datalad "containers.validate"]
	image = code/containers/images/TODO
	cmdexec = {img} {cmd}
	faire-check = blocking
	faire-stage = collection
	faire-stage = release
	faire-cmd = TODO .
[datalad "containers.report"]
	image = code/containers/images/TODO
	cmdexec = {img} {cmd}
	faire-check = advisory
	faire-stage = collection
	faire-cmd = TODO .
